CRM_USERNAME=
CRM_PASSWORD=
CRM_CONNECTOR_TOKEN=
# Fill these with the stable HTTPS address of the local gateway after the
# PostgreSQL cutover. The configure-connector-local-gateway.ps1 script writes
# all four values without touching CRM credentials or local snapshots.
DASHBOARD_API_URL=https://YOUR-GATEWAY.example/api/crm-shadow
DASHBOARD_ACTIVITY_API_URL=https://YOUR-GATEWAY.example/api/crm-activity
DASHBOARD_CRM_CONFIG_URL=https://YOUR-GATEWAY.example/api/crm-config
DASHBOARD_CONNECTOR_COMMAND_URL=https://YOUR-GATEWAY.example/api/connector-command
